# PostgreSQL connection string (matches docker-compose.yml; dev-only credentials)
DATABASE_URL=postgres://jala:jala_dev_password@localhost:5432/jala

# Public base URL of the app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OSRM-compatible routing server. The default is the public demo server:
# fine for the hackathon, not for production traffic.
ROUTING_BASE_URL=https://router.project-osrm.org

# debug | info | warn | error
LOG_LEVEL=info

# Transactional email via Resend. Without a key, emails are only logged.
# RESEND_API_KEY=
# MAIL_FROM=Jala <jala@jala.oak4.xyz>
